import tkinter as tk
from tkinter import messagebox
import random

# -------------------------
# These are the  helper function which the program have to run by its own 
# -------------------------

def displayMenu():
    """Show the difficulty selection menu."""
    app.show_menu()

def randomInt(min_val, max_val):
    """Return a random integer between min_val and max_val (inclusive)."""
    return random.randint(min_val, max_val)

def decideOperation():
    """Randomly choose an operation and return '+' or '-'."""
    return random.choice(['+', '-'])

def displayProblem(question_text):
    """Display the current arithmetic question on the GUI."""
    app.show_problem(question_text)

def isCorrect(user_answer, correct_answer):
    """
    Check whether the user answer is correct.
    Returns True or False.
    """
    return user_answer == correct_answer

def displayResults():
    """Display the final score and grade."""
    app.show_results_screen()

# -------------------------
# this is the main class which will control the GUI
# -------------------------

class MathQuizApp:
    def __init__(self, master):
        self.master = master
        self.master.title("Maths Quiz")

        # this section will be keeping the track of the  guizs main information
        self.difficulty = None
        self.min_val = 0
        self.max_val = 9
        self.total_questions = 10
        self.current_question_index = 0
        self.current_correct_answer = None
        self.current_attempt = 1
        self.score = 0

        # ------------- Frames -------------
        self.menu_frame = tk.Frame(self.master, padx=20, pady=20)
        self.quiz_frame = tk.Frame(self.master, padx=20, pady=20)
        self.result_frame = tk.Frame(self.master, padx=20, pady=20)

        self.build_menu_frame()
        self.build_quiz_frame()
        self.build_result_frame()

        # this will help in Showing menu at start
        self.show_menu()

    # -------------------- UI Construction --------------------

    def build_menu_frame(self):
        title_lbl = tk.Label(
            self.menu_frame,
            text="DIFFICULTY LEVEL",
            font=("Arial", 18, "bold")
        )
        title_lbl.pack(pady=(0, 10))

        btn_easy = tk.Button(
            self.menu_frame,
            text="1. Easy (single digit)",
            width=25,
            command=lambda: self.start_quiz("easy")
        )
        btn_moderate = tk.Button(
            self.menu_frame,
            text="2. Moderate (double digit)",
            width=25,
            command=lambda: self.start_quiz("moderate")
        )
        btn_advanced = tk.Button(
            self.menu_frame,
            text="3. Advanced (4 digits)",
            width=25,
            command=lambda: self.start_quiz("advanced")
        )

        btn_easy.pack(pady=5)
        btn_moderate.pack(pady=5)
        btn_advanced.pack(pady=5)

    def build_quiz_frame(self):
        self.question_label = tk.Label(
            self.quiz_frame,
            text="",
            font=("Arial", 16)
        )
        self.question_label.grid(row=0, column=0, columnspan=2, pady=(0, 10))

        tk.Label(self.quiz_frame, text="Your Answer:").grid(
            row=1, column=0, sticky="e"
        )

        self.answer_entry = tk.Entry(self.quiz_frame, width=10)
        self.answer_entry.grid(row=1, column=1, sticky="w")

        self.feedback_label = tk.Label(
            self.quiz_frame,
            text="",
            font=("Arial", 12)
        )
        self.feedback_label.grid(row=2, column=0, columnspan=2, pady=(10, 10))

        self.submit_button = tk.Button(
            self.quiz_frame,
            text="Submit",
            command=self.check_answer
        )
        self.submit_button.grid(row=3, column=0, pady=5)

        self.quit_button = tk.Button(
            self.quiz_frame,
            text="Quit",
            command=self.master.destroy
        )
        self.quit_button.grid(row=3, column=1, pady=5)

        self.progress_label = tk.Label(
            self.quiz_frame,
            text="Question 0 / 10"
        )
        self.progress_label.grid(row=4, column=0, columnspan=2, pady=(10, 0))

    def build_result_frame(self):
        self.final_score_label = tk.Label(
            self.result_frame,
            text="",
            font=("Arial", 16, "bold")
        )
        self.final_score_label.pack(pady=(0, 10))

        self.grade_label = tk.Label(
            self.result_frame,
            text="",
            font=("Arial", 14)
        )
        self.grade_label.pack(pady=(0, 10))

        self.play_again_button = tk.Button(
            self.result_frame,
            text="Play Again",
            command=self.reset_and_back_to_menu
        )
        self.play_again_button.pack(pady=5)

        self.close_button = tk.Button(
            self.result_frame,
            text="Exit",
            command=self.master.destroy
        )
        self.close_button.pack(pady=5)

    #  this will handle switching between the screens

    def hide_all_frames(self):
        self.menu_frame.pack_forget()
        self.quiz_frame.pack_forget()
        self.result_frame.pack_forget()

    def show_menu(self):
        self.hide_all_frames()
        self.menu_frame.pack()

    def show_quiz(self):
        self.hide_all_frames()
        self.quiz_frame.pack()

    def show_results_screen(self):
        self.hide_all_frames()
        self.update_results_text()
        self.result_frame.pack()

    # this is the core of the Quiz  

    def start_quiz(self, level):
        self.difficulty = level

        if level == "easy":
            self.min_val, self.max_val = 0, 9
        elif level == "moderate":
            self.min_val, self.max_val = 10, 99
        elif level == "advanced":
            self.min_val, self.max_val = 1000, 9999

        self.score = 0
        self.current_question_index = 0
        self.current_attempt = 1

        self.show_quiz()
        self.next_question()

    def next_question(self):
        if self.current_question_index >= self.total_questions:
            #  End of the quiz
            displayResults()
            return

        # creates the values and the operation
        a = randomInt(self.min_val, self.max_val)
        b = randomInt(self.min_val, self.max_val)
        op = decideOperation()

        if op == '+':
            self.current_correct_answer = a + b
        else:
            self.current_correct_answer = a - b

        question_txt = f"{a} {op} {b} ="
        self.current_question_index += 1
        self.current_attempt = 1

        displayProblem(question_txt)
        self.progress_label.config(
            text=f"Question {self.current_question_index} / {self.total_questions}"
        )

    def show_problem(self, question_text):
        self.question_label.config(text=question_text)
        self.answer_entry.delete(0, tk.END)
        self.feedback_label.config(text="")

    def check_answer(self):
        user_input = self.answer_entry.get().strip()
        if user_input == "":
            messagebox.showinfo("Input needed", "Please type an answer before submitting.")
            return

        try:
            user_value = int(user_input)
        except ValueError:
            messagebox.showerror("Invalid input", "Please enter a whole number.")
            return

        if isCorrect(user_value, self.current_correct_answer):
            # Correct on first or second attempt
            if self.current_attempt == 1:
                self.score += 10
                self.feedback_label.config(text="Correct! +10 points")
            else:
                self.score += 5
                self.feedback_label.config(text="Correct on second try! +5 points")

            self.master.after(700, self.next_question)  # brief pause then next
        else:
            # wrong
            if self.current_attempt == 1:
                self.current_attempt = 2
                self.feedback_label.config(
                    text="Not quite. Try once more!"
                )
                self.answer_entry.delete(0, tk.END)
            else:
                # The answer was wrong;mone on .
                self.feedback_label.config(
                    text=f"Incorrect. The right answer was {self.current_correct_answer}."
                )
                self.master.after(1000, self.next_question)

    def update_results_text(self):
        # Displaying the final score out of 100.
        final_txt = f"Your final score: {self.score} / 100"
        self.final_score_label.config(text=final_txt)

        # Grade boundaries ( it is adjustable if needed)
        if self.score >= 90:
            grade = "A+"
            msg = "Outstanding!"
        elif self.score >= 80:
            grade = "A"
            msg = "Excellent work!"
        elif self.score >= 70:
            grade = "B"
            msg = "Good job!"
        elif self.score >= 60:
            grade = "C"
            msg = "Not bad, keep practising."
        else:
            grade = "D"
            msg = "Keep trying, you'll improve!"

        self.grade_label.config(
            text=f"Grade: {grade}\n{msg}"
        )

    def reset_and_back_to_menu(self):
        self.score = 0
        self.current_question_index = 0
        self.current_attempt = 1
        self.current_correct_answer = None
        self.show_menu()

# -------------------------
# Start  the application
# -------------------------

if __name__ == "__main__":
    root = tk.Tk()
    app = MathQuizApp(root)
    displayMenu()  # start at menu
    root.mainloop()
